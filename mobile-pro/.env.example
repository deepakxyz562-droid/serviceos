# Fieseros Mobile App Environment Variables
# Copy to .env and adjust as needed

# EXPO_PUBLIC_API_BASE_URL is the Fieseros backend (web app API)
EXPO_PUBLIC_API_BASE_URL=https://fieseros.com

# EAS_PROJECT_ID — required for push notifications (Expo SDK 50+).
# Get this from https://expo.dev → your project → Project ID (a UUID).
# Or run `eas init` in the mobile-app directory to create an EAS project.
# Without this, push notification registration will be skipped.
EAS_PROJECT_ID=

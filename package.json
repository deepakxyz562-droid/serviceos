{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build && bun scripts/standalone-cleanup.js && bash scripts/sync-public-to-standalone.sh",
    "sync-public": "bash scripts/sync-public-to-standalone.sh",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "bun run prisma/seed-users.ts",
    "db:seed-emails": "bun run prisma/seed-email-templates.ts",
    "db:seed-full": "bun run prisma/seed.ts",
    "db:generate-seed-sql": "bun run prisma/generate-seed-sql.ts",
    "supabase:query": "bun run src/scripts/supabase-query.ts",
    "prod": "NODE_OPTIONS=\"--max-old-space-size=512\" next start -p 3000 2>&1 | tee dev.log",
    "indexnow": "bun run scripts/indexnow-submit.ts",
    "indexnow:blog": "bun run scripts/indexnow-submit.ts --blog",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e:install": "playwright install --with-deps",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "analyze": "ANALYZE=true next build"
  },

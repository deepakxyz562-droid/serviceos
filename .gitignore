# Database
db/*.db
db/*.db-journal

# Skills directory (not part of the app)
/skills/

# Uploads & screenshots
/upload/
*.png
*.jpg
*.jpeg
*.gif
*.webp

# Mobile app assets MUST NOT be ignored (required for EAS Build)
# The *.png rule above excludes ALL png files globally. EAS Build
# reads this .gitignore when creating the build archive, which causes
# mobile-app/assets/*.png to be excluded → build fails with ENOENT.
# These un-ignore rules override the *.png rule for mobile-app assets.
!mobile-app/assets/
!mobile-app/assets/**
!quote-flow-mobile/assets/
!quote-flow-mobile/assets/**
.expo/

# Agent context files
/agent-ctx/

# Mini services
/mini-services/

# Examples
/examples/

# Prisma migrations (using db push instead)
/prisma/migrations/*
!/prisma/migrations/20261007150000_commerce_consistency/

# Worklog
worklog.md

# Daemon
daemon.js

# Screenshots
canvas-screenshot.png
dashboard-check.png
landing-check*.png

# Start scripts
start-dev.sh

# Z scripts
/.zscripts/

# Caddy
Caddyfile

# Downloads
/download/
tool-results/

# sitemaps
/public/sitemap.xml
/public/sitemap/

# Playwright
playwright-report/
test-results/
playwright/.cache/

# Build output (regenerated by bun run build)
/standalone/

# Debug dumps
*.har
*.har.json
fieseros-har.json
fieseros.com.json

# Temp artifacts
/temp/

# Runtime PID files
next-dev.pid

# Scratch
/.scratch/


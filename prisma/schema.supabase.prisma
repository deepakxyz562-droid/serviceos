// ============================================================================
// PRODUCTION SCHEMA FOR SUPABASE / POSTGRESQL
// ============================================================================
// This is the Postgres-compatible variant of prisma/schema.prisma.
// The checked-in schema.prisma uses `provider = "sqlite"` for the local
// sandbox. In production with USE_SUPABASE_DB=true, the app talks to Supabase
// via the PostgREST adapter (src/lib/supabase-db.ts) and does NOT need Prisma
// at runtime — but the TABLES + COLUMNS must still exist in Postgres.
//
// To create/migrate the tracking tables in Supabase:
//
//   OPTION A (recommended): run the raw SQL migration directly.
//     psql "$DIRECT_URL" -f prisma/migrations/supabase-tracking-tables.sql
//   OR paste it into the Supabase Dashboard → SQL Editor → Run.
//
//   OPTION B: switch the active schema to postgres and use prisma db push.
//     1. Copy this file over schema.prisma (or use --schema).
//     2. `npx prisma db push --schema prisma/schema.supabase.prisma`
//        (use DIRECT_URL — the port 5432 connection, NOT the pooler on 6543)
//
// IMPORTANT: never run `prisma db push` against the pooler URL (port 6543).
//   PgBouncer in transaction mode does not support the session-level commands
//   prisma db push uses. Always use DIRECT_URL (port 5432) for migrations.
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")      // pooler (port 6543) for runtime
  directUrl = env("DIRECT_URL")       // direct (port 5432) for migrations
}

// ============================================================================
// GPS & LIVE TRACKING TABLES (Wave 3)
// ============================================================================

// 12. GPSLocation — append-only GPS pings from employees during travel.
model GPSLocation {
  id           String   @id @default(cuid())
  tenantId     String
  employeeId   String // -> Employee.id
  jobId        String? // -> Job.id (if tracking for a specific job)
  latitude     Float
  longitude    Float
  accuracy     Float? // meters
  heading      Float? // degrees
  speed        Float? // m/s
  altitude     Float?
  capturedAt   DateTime @default(now())
  batteryLevel Float? // 0-1
  isMoving     Boolean  @default(false)
  syncStatus   String   @default("synced") // synced, pending, failed
  createdAt    DateTime @default(now())

  @@index([tenantId, employeeId, capturedAt])
  @@index([tenantId, jobId, capturedAt])
  @@index([tenantId, syncStatus])
}

// 13. RouteHistory — a summary of a technician's route for a job/day.
model RouteHistory {
  id             String    @id @default(cuid())
  tenantId       String
  employeeId     String // -> Employee.id
  jobId          String? // -> Job.id (if for a specific job)
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  // Path stored as JSON: [{lat, lng, capturedAt, accuracy}]
  // NOTE: kept as String (TEXT) on purpose so JSON.stringify/JSON.parse
  // round-trips identically to the SQLite sandbox. If you change this to
  // Json, the application code in src/app/api/gps/track/route.ts must be
  // updated to send the array directly (not a stringified string).
  pathJson       String    @default("[]")
  distanceMeters Float     @default(0)
  durationMinutes Int      @default(0)
  avgSpeedKmh    Float     @default(0)
  startLat       Float?
  startLng       Float?
  endLat         Float?
  endLng         Float?
  etaMinutes     Int?
  arrivedAt      DateTime?
  status         String    @default("in_progress") // in_progress, completed, cancelled
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, employeeId, startedAt])
  @@index([tenantId, jobId])
  @@index([tenantId, status])
}

// Employee columns used by Live Dispatch (already in schema.prisma —
// included here for migration reference). If your Employee table is missing

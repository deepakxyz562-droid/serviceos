# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# When USE_SUPABASE_DB=true, the app uses Supabase REST API (PostgREST)
# and does NOT need DATABASE_URL for runtime queries.
#
# However, DATABASE_URL is still needed for:
#   - Prisma schema migrations (bun run db:push)
#   - Fallback if Supabase REST API is disabled
#
# For local development (SQLite):
DATABASE_URL=file:./db/custom.db
#
# For Neon PostgreSQL:
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
# DIRECT_URL=postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
#
# For Supabase PostgreSQL (recommended for production):
# Get your connection string from: Supabase Dashboard → Settings → Database
# DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# DIRECT_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ============================================================
# SUPABASE CONFIGURATION (required when USE_SUPABASE_DB=true)
# ============================================================
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================================
# DATABASE MODE SWITCH
# ============================================================
# true  = Use Supabase REST API (PostgREST) — no direct SQL connections
# false = Use Prisma with DATABASE_URL for direct SQL connections
USE_SUPABASE_DB=false

# ============================================================
# GOOGLE OAUTH
# ============================================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional comma-separated OAuth client IDs accepted by QuoteFlow mobile.
# GOOGLE_CLIENT_ID is always included automatically.
QUOTEFLOW_GOOGLE_CLIENT_IDS=

# ============================================================
# JWT SECRET
# ============================================================
JWT_SECRET=your-production-jwt-secret

# ============================================================
# PAYPAL
# ============================================================
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret
PAYPAL_MERCHANT_EMAIL=your_paypal_email@example.com
PAYPAL_SANDBOX=true

# ============================================================
# WHATSAPP & META PLATFORM (App Review & Embedded Signup)
# ============================================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=flowforge_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret
META_APP_ID=your_meta_app_id
NEXT_PUBLIC_META_APP_ID=your_meta_app_id
NEXT_PUBLIC_WHATSAPP_EMBEDDED_CONFIG_ID=your_whatsapp_embedded_signup_configuration_id

# ============================================================
# AI RECEPTIONIST ADDON (Phone Agent — $29/mo + 150 min)
# ============================================================
# Twilio credentials for provisioning dedicated voice + SMS numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER_SID=

# Vapi credentials for the AI voice assistant (inbound call handling).
VAPI_API_KEY=
VAPI_ORG_ID=

# Encryption key for OAuth/integration tokens stored in the DB.
# Generate with: openssl rand -hex 32
AI_PROVIDER_ENCRYPTION_KEY=

# Creem payment provider (for the addon checkout flow at /api/addons/checkout).
# The Creem API key is DB-backed (SuperAdmin → Revenue Dashboard), but the
# webhook secret MUST be set in env so the /api/creem/webhook route can
# verify incoming events.
CREEM_WEBHOOK_SECRET=

# ============================================================
# CRON SECRET (REQUIRED for scheduled jobs)
# ============================================================
# Shared secret used to authenticate external cron job calls.
# Generate with: openssl rand -hex 32
# All 12 cron routes under /api/cron/* require this secret.
# Set it in your 3rd-party cron service (cron-job.org / GitHub Actions).
CRON_SECRET=generate-a-strong-random-secret-here

# ============================================================
# APP URL (for webhook callbacks, canonical URLs, subdomain detection)
# ============================================================
# Production:  https://fieseros.com
# Staging:     https://staging.fieseros.com
# Local dev:   http://localhost:3000 (or leave unset)
NEXT_PUBLIC_APP_URL=https://fieseros.com

# ============================================================
# COOLIFY + SUPABASE DEPLOYMENT CHECKLIST
# ============================================================
# When deploying on Coolify (Hostinger VPS) + Supabase, set ALL
# these env vars in Coolify → Project → Environment Variables:
#
# 1. DATABASE_URL          → Supabase PostgreSQL connection string
#                            (or leave unset if using Supabase REST API only)
# 2. USE_SUPABASE_DB       → true (uses PostgREST REST API, no direct SQL)
# 3. NEXT_PUBLIC_SUPABASE_URL → https://your-project.supabase.co
# 4. SUPABASE_SERVICE_ROLE_KEY → eyJ... (server-side only, NO NEXT_PUBLIC_ prefix)
# 5. SUPABASE_ANON_KEY     → eyJ...
# 6. JWT_SECRET            → your-production-secret (openssl rand -hex 32)
# 7. CRON_SECRET           → strong random secret (openssl rand -hex 32)
#                            Used by /api/cron/* endpoints + cron-job.org
# 8. NEXT_PUBLIC_APP_URL   → https://fieseros.com (your production domain)
#
# IMPORTANT: After changing env vars in Coolify, you MUST
# trigger a redeploy for changes to take effect.
#
# CRON SCHEDULING: Coolify does NOT run Vercel/Netlify-style crons.
# All scheduled jobs run via cron-job.org (see cron-configs/README.md).
# This project's Dockerfile builds a Next.js standalone image — no
# platform-specific build or runtime coupling.

# ============================================================
# PAYMENT CREDENTIALS ENCRYPTION KEY (REQUIRED for payment widgets)
# ============================================================
# 32-byte hex string (64 characters) used to AES-256-GCM encrypt
# user payment credentials (Stripe secretKey, PayPal clientSecret,
# Razorpay keySecret, etc.) before storing them in the database.
#
# Generate one with:
#   openssl rand -hex 32
#
# CRITICAL: Do NOT commit the real key. Keep it only in your
# production environment. If this key is lost, all encrypted
# payment credentials become unrecoverable.
ENCRYPTION_KEY=replace_with_32_byte_hex_string_64_chars_total_generate_with_openssl_rand_hex_32

# Private 32-byte random secret for signed guest order links; never expose in NEXT_PUBLIC variables.
PUBLIC_ORDER_TOKEN_SECRET=

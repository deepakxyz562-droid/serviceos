# Public build-time values only. Never put Google client secrets or service keys here.
EXPO_PUBLIC_API_URL=https://bgos.fieseros.com
EXPO_PUBLIC_WEB_URL=https://bgos.fieseros.com
# Optional overrides for Firebase Phone Auth (native SDK, in-app WebView reCAPTCHA & REST verification)
# EXPO_PUBLIC_BGOS_FIREBASE_API_KEY=
# EXPO_PUBLIC_BGOS_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_BGOS_FIREBASE_PROJECT_ID=
# Set the real BGOS EAS project UUID in each EAS environment.
EXPO_PUBLIC_EAS_PROJECT_ID=
